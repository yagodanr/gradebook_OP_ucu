def get_summary_grade(gradebook: dict) -> dict:
    """
    gets the sum of points for students or student
    :param gradebook: dictionary with student evaluations
    :return: a dictionary with student's names and student's sum of points
    >>> gradebook = {
    ...     "Олексій Коваленко": {
    ...         "Лабораторні роботи": {
    ...             "Лабораторна робота 1": 1,
    ...             "Лабораторна робота 2": 1,
    ...             "Лабораторна робота 3": 1,
    ...             "Лабораторна робота 4": 1
    ...         },
    ...         "Проміжний іспит": {
    ...             "Теоретичне завдання": 4,
    ...             "Завдання на програмування": 10
    ...         },
    ...         "Тести по лекційним матеріалам": {
    ...             "Тест 1": 0.5,
    ...             "Тест 2": 0.5,
    ...             "Тест 3": 0.5,
    ...             "Тест 4": 0.5,
    ...             "Тест 5": 0.5,
    ...             "Тест 6": 0.5
    ...         },
    ...         "Тести на LMS": {
    ...             "Тест 1": 0.3,
    ...             "Тест 2": 0.3,
    ...             "Тест 3": 0.3,
    ...             "Тест 4": 0.3,
    ...             "Тест 5": 0.3,
    ...             "Тест 6": 0.3,
    ...             "Тест 7": 0.3,
    ...             "Тест 8": 0.3,
    ...             "Тест 9": 0.3,
    ...             "Тест 10": 0.3
    ...         },
    ...         "Міні-проєкти": {
    ...             "Міні-проєкт 1": 8,
    ...             "Міні-проєкт 2": 7
    ...         },
    ...         "Фінальний іспит": {
    ...             "Теоретичне завдання": 6,
    ...             "Завдання на програмування": 18
    ...         },
    ...         "Додаткові бали": 4
    ...     }
    ... }
    >>> get_summary_grade(gradebook)
    {'Олексій Коваленко': 67.0}
    """
    summary = {}
    
    for student, grades in gradebook.items():
        total_grade = 0
        
        # Лабораторні роботи
        if "Лабораторні роботи" in grades:
            for lab, score in grades["Лабораторні роботи"].items():
                total_grade += score
        
        # Проміжний іспит
        if "Проміжний іспит" in grades:
            for midterm, score in grades["Проміжний іспит"].items():
                total_grade += score
        
        # Тести по лекційним матеріалам
        if "Тести по лекційним матеріалам" in grades:
            for test_lecture, score in grades["Тести по лекційним матеріалам"].items():
                total_grade += score
        
        # Тести на LMS
        if "Тести на LMS" in grades:
            for test_LMS, score in grades["Тести на LMS"].items():
                total_grade += score
        
        # Міні-проєкти
        if "Міні-проєкти" in grades:
            for project, score in grades["Міні-проєкти"].items():
                total_grade += score
        
        # Фінальний іспит
        if "Фінальний іспит" in grades:
            for exam, score in grades["Фінальний іспит"].items():
                total_grade += score
        
        # Додаткові бали
        if "Додаткові бали" in grades:
            total_grade += grades["Додаткові бали"]
        
        # Зберіагємо оцінку студента
        summary[student] = round(total_grade, 2)

    return summary
